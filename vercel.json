{
  "version": 2,
  "trailingSlash": false,
  "crons": [
    {
      "path": "/api/cron/fetch-hazards",
      "schedule": "0 */6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/notifications/broadcast",
      "destination": "/api/notifications/broadcast"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
