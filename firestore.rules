rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /township_hubs/{hubId} {
      allow read: if true;
      allow write: if true;
    }
    match /places/{placeId} {
      allow read: if true;
      allow write: if true;
    }
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if true;
    }
    match /traffic_alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }
    function isSignedIn() { return request.auth != null; }
    function isSuperAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'ayahsyirah77@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isAdmin() { return isSuperAdmin(); }
    function isValidHazardAlert(data) {
       return data.title is string && data.title.size() <= 100 &&
              data.description is string && data.description.size() <= 500 &&
              data.severity in ['low', 'medium', 'high', 'moderate', 'critical'] &&
              data.type in ['landslide', 'road_closure', 'hazard'] &&
              data.source is string && data.source.size() <= 50;
    }

    match /hazard_alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }
    match /vendor_listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /vendor_vouchers/{voucherId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /vendor_events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }
    match /vendor_staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSignedIn();
    }
    match /farm_tickets/{ticketId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }
    match /lounge/{postId} {
      allow read: if true;
      allow write: if true;
    }
    match /lounge/{postId}/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /emergency_cards/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /sos_dispatches/{dispatchId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gsap_card_images/{cardId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }
    match /section_bg_images/{imageId} {
      allow read: if true;
      allow write: if isAdmin() || true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
    match /itinerary/{itineraryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /beacon_sessions/{sessionId} {
      allow read, write: if true;
    }
    match /beacon_sessions/{sessionId}/members/{memberId} {
      allow read, write: if true;
    }
    match /ai_chats/{chatId} {
      allow read, write: if true;
    }
    match /ai_chats/{chatId}/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
