rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ayahsyirah77@gmail.com' ||
        request.auth.token.email.matches('.*admin.*') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    match /township_hubs/{hubId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }
    
    match /places/{placeId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }
    
    match /gallery/{galleryId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }
    
    match /traffic_alerts/{alertId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /hazard_alerts/{alertId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /vendor_listings/{listingId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /motorbike_partners/{partnerId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /motorbike_rentals/{rentalId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /vendor_vouchers/{voucherId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /vendor_events/{eventId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /vendor_staff/{staffId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /farm_tickets/{ticketId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /events/{eventId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /jobs/{jobId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /lounge/{postId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /emergency_cards/{userId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /sos_dispatches/{dispatchId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /settings/{settingId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /gsap_images/{docId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /gsap_card_images/{cardId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /section_bg_images/{imageId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /users/{userId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /itinerary/{itineraryId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /beacon_sessions/{sessionId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /ai_chats/{chatId} {
      allow read, write: if true;
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
