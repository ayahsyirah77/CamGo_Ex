rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ayahsyirah77@gmail.com' ||
        request.auth.token.email.matches('.*admin.*') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Publicly readable collections
    match /township_hubs/{hubId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /gallery/{galleryId} {
      allow read: if true;
      allow write: if true; // Keeping write public as requested by existing code/errors
    }
    
    match /traffic_alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hazard_alerts/{alertId} {
      allow read: if true;
      allow write: if true;
    }

    match /vendor_listings/{listingId} {
      allow read, write: if true;
    }

    match /motorbike_partners/{partnerId} {
      allow read, write: if true;
    }

    match /motorbike_rentals/{rentalId} {
      allow read, write: if true;
    }

    match /vendor_vouchers/{voucherId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid));
    }

    match /vendor_events/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid));
    }

    match /vendor_staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /farm_tickets/{ticketId} {
      allow read: if true;
      allow write: if isAdmin() || isSignedIn();
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if true;
    }

    match /lounge/{postId} {
      allow read: if true;
      allow write: if true;
      
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /emergency_cards/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /sos_dispatches/{dispatchId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gsap_card_images/{cardId} {
      allow read: if true;
      allow write: if true;
    }

    match /section_bg_images/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /itinerary/{itineraryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /beacon_sessions/{sessionId} {
      allow read, write: if true;
      
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    match /ai_chats/{chatId} {
      allow read, write: if true;
      
      match /{allSubpaths=**} {
        allow read, write: if true;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
